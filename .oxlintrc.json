{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react", "import"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"env": {
		"browser": true,
		"node": true
	},
	"ignorePatterns": ["**/dist/**", ".claude/skills/logo-design/**", ".claude/skills/naming/**"],
	"rules": {
		"react/react-in-jsx-scope": "off",
		"react/style-prop-object": "off",
		"no-unused-vars": [
			"error",
			{
				"ignoreRestSiblings": true,
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_"
			}
		],
		"import/no-unassigned-import": [
			"warn",
			{
				"allow": ["**/*.css", "dayjs/locale/*"]
			}
		]
	}
}
