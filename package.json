{
	"name": "jobhunt",
	"private": true,
	"version": "0.9.0",
	"description": "Local-first job hunt tracker: Claude Code finds jobs, you apply.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"start": "vite --open",
		"demo": "vite --mode demo --open",
		"test": "vitest run",
		"build": "tsc && vite build",
		"typecheck": "tsc",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"fmt:check": "oxfmt --check",
		"check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm leads:check && pnpm test",
		"leads:check": "node src/check-leads.ts"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "5.2.5",
		"@fontsource/ibm-plex-sans": "5.2.5",
		"@mantine/core": "9.8.1",
		"@mantine/dates": "9.8.1",
		"@mantine/hooks": "9.8.1",
		"@mantine/notifications": "9.8.1",
		"dayjs": "1.11.23",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.1"
	}
}
